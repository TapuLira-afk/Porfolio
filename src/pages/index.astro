---
import BaseLayout from "../layouts/BaseLayout.astro";
import imagenReloj from '../assets/reloj-jucio-final.png';

const proyectos = [
	{
		titulo: "El Reloj del Juicio Final",
		descripcion: "Explora el código fuente o visualiza la demo en vivo.",
		imagen: imagenReloj.src,
		urlCodigo: "https://github.com/TapuLira-afk/El-Reloj-del-Juicio-Final",
		urlDemo: "https://tapulira-afk.github.io/El-Reloj-del-Juicio-Final/",
	},
	{
		titulo: "Otro Proyecto",
		descripcion: "Una descripción breve de tu segundo proyecto.",
		imagen: "https://picsum.photos/400/200?random=2",
		urlCodigo: "https://github.com/tu-repo-2",
		urlDemo: "https://tu-demo-2.com",
	},
];
---

<BaseLayout title="Proyectos | Lira Acedo Gijon">
	<main class="proyectos-main">
		<h1 class="titulo-seccion">Mis Proyectos</h1>
		<section class="proyectos-grid">
			{
				proyectos.map((proyecto) => (
					<div class="card">
						<img
							src={proyecto.imagen}
							alt={proyecto.titulo}
							class="card-image"
						/>
						<div class="card-content">
							<h3 class="card-title">{proyecto.titulo}</h3>
							<p class="card-description">
								{proyecto.descripcion}
							</p>
							<div class="card-actions">
								<a
									href={proyecto.urlCodigo}
									target="_blank"
									rel="noopener noreferrer"
									class="btn btn-code"
								>
									Código
								</a>
								<a
									href={proyecto.urlDemo}
									target="_blank"
									rel="noopener noreferrer"
									class="btn btn-run"
								>
									Ejecución
								</a>
							</div>
						</div>
					</div>
				))
			}
		</section>
	</main>
</BaseLayout>

<style>
	.proyectos-main {
		max-width: 1200px;
		margin: 0 auto;
		padding: 3rem 2rem;
		min-height: 80vh;
	}
	.titulo-seccion {
		font-size: 2.5rem;
		color: #ffc20a;
		text-align: center;
		margin-bottom: 3rem;
		text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
	}
	.proyectos-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2.5rem;
	}
	.card {
		background: #fff;
		border-radius: 12px;
		overflow: hidden;
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
		transition:
			transform 0.3s ease,
			box-shadow 0.3s ease;
		display: flex;
		flex-direction: column;
	}
	.card:hover {
		transform: translateY(-5px);
		box-shadow: 0 12px 25px rgba(0, 0, 0, 0.4);
	}
	.card-image {
		width: 100%;
		height: 200px;
		object-fit: cover;
		border-bottom: 4px solid #f3620f;
	}
	.card-content {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}
	.card-title {
		font-size: 1.5rem;
		color: #f3620f;
		margin: 0 0 0.5rem 0;
	}
	.card-description {
		color: #333;
		font-size: 1rem;
		line-height: 1.5;
		margin-bottom: 1.5rem;
		flex-grow: 1;
	}
	.card-actions {
		display: flex;
		gap: 1rem;
		margin-top: auto;
	}
	.btn {
		text-decoration: none;
		padding: 0.6rem 1.2rem;
		border-radius: 6px;
		font-weight: bold;
		font-size: 0.9rem;
		text-align: center;
		flex: 1;
		transition:
			opacity 0.3s ease,
			transform 0.2s ease;
	}
	.btn:hover {
		opacity: 0.85;
		transform: scale(1.02);
	}
	.btn-code {
		background: #ffc20a;
		color: #084973;
		border: 2px solid #ffc20a;
	}
	.btn-run {
		background: #078d8c;
		color: #fff;
		border: 2px solid #078d8c;
	}
	@media (max-width: 768px) {
		.proyectos-main {
			padding: 2rem 1rem;
		}
		.titulo-seccion {
			font-size: 2rem;
		}
		.card-actions {
			flex-direction: column;
		}
	}
</style>
